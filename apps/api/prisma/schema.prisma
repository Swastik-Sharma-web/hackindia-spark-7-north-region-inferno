generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  wallet        String   @unique
  name          String?
  email         String?  @unique
  picture       String?
  reputation    Int      @default(0)
  jobsCompleted Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobsPosted    Job[]       @relation("ClientJobs")
  jobsTaken     Job[]       @relation("FreelancerJobs")
  challenges    Challenge[]
}

model Job {
  id             String    @id @default(cuid())
  title          String
  description    String
  skill          String
  budget         String
  score          String
  timeline       String
  details        String[]
  status         String    @default("OPEN") // OPEN, IN_PROGRESS, DELIVERED, RELEASED, DISPUTED
  escrowStatus   String?   @default("UNFUNDED") // UNFUNDED, LOCKED, RELEASED, REFUNDED
  escrowTxHash   String?
  escrowId       String?
  submittedWork  String?
  disputeReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clientId       String
  client         User      @relation("ClientJobs", fields: [clientId], references: [id])
  freelancerId   String?
  freelancer     User?     @relation("FreelancerJobs", fields: [freelancerId], references: [id])
}

model Challenge {
  id           String    @id @default(cuid())
  skill        String
  title        String
  description  String
  requirements String[]
  rubric       String[]
  score        Int?
  feedback     String?
  submission   String?
  status       String    @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  userId       String
  user         User      @relation(fields: [userId], references: [id])
}

model SiweNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
